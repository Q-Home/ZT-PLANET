# Public hostname
ZT_DOMAIN=zt.example.com
NEXTAUTH_URL=https://zt.example.com

# Public ZeroTier root endpoint. Use public IPv4 or DNS name.
ZT_PUBLIC_ENDPOINT=203.0.113.10/9993

# Database
POSTGRES_USER=ztnet
